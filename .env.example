# ===== GOOGLE DRIVE =====
# ВАРИАНТ 1 (ПРОСТОЙ): Публичная ссылка на файл
# Просто поделитесь файлом с доступом "Любой, у кого есть ссылка"
# Пример: https://drive.google.com/file/d/1abc123xyz/view?usp=sharing
GOOGLE_DRIVE_PUBLIC_URL=

# ВАРИАНТ 2 (СЛОЖНЫЙ): Google Drive API
# ID папки на Google Drive с расписанием
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Путь к credentials файлу Google API
GOOGLE_CREDENTIALS_FILE=credentials.json

# Режим работы: simple (публичная ссылка) или api (полный API)
GOOGLE_DRIVE_MODE=simple

# ===== SYNC SETTINGS =====
# Частота проверки обновлений (в минутах)
SYNC_INTERVAL_MINUTES=15

# Режим синхронизации (auto/manual)
SYNC_MODE=auto

# ===== NOTIFICATIONS =====
# Время утренних уведомлений (формат HH:MM)
MORNING_NOTIFICATION_TIME=07:00

# За сколько минут уведомлять до пары
BEFORE_CLASS_NOTIFICATION_MINUTES=15

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ===== TIMEZONE =====
TIMEZONE=Asia/Tashkent
